# Public counter script on the landing page. This domain is not a secret.
# Leave it blank to keep landing-page tracking off.
VITE_PLAUSIBLE_DOMAIN=

# Optional script address. Leave unset to use https://plausible.io/js/script.js.
# Do not switch on Plausible's outbound-link script.
# VITE_PLAUSIBLE_SRC=

# Server-only settings for the audience dashboard. Never prefix these with VITE_.
PLAUSIBLE_DOMAIN=
PLAUSIBLE_API_KEY=

# Optional stats API origin. Leave unset to use https://plausible.io.
# PLAUSIBLE_API=
