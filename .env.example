# Plausible site domain, exactly as added in Plausible.
# Leave this blank to keep tracking off. Do not put student information here.
VITE_PLAUSIBLE_DOMAIN=

# Read-only stats key for the staff dashboard at /dashboard.html.
# The key is visible in that page's code, so do not use a key that can edit the site.
VITE_PLAUSIBLE_API_KEY=

# Optional script address. Leave unset to use https://plausible.io/js/script.js.
# Do not switch on Plausible's outbound-link script. Channel clicks are counted
# only by youtube_channel_click and whatsapp_channel_click.
# VITE_PLAUSIBLE_SRC=
